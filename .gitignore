# Local builds and runtime state
/out/
/build/
/runtime/
/reports/
/.docker-temp/
/vcpkg_installed/

# Machine-specific model artifacts
/engines/*.engine
/engines/*.plan
/engines/*.onnx
/engines/*.pt
/engines/*.pth
/models/
/datasets/

# Dataset payloads stay outside Git; only versioned manifests are tracked.
/data/raw/
/data/interim/
/data/processed/
/data/cache/

# IDE/user-specific files
/.vs/
/.vscode/
/CMakeUserPresets.json
/CMakeSettings.json
*.user
*.suo

# Logs, databases and secrets
*.log
*.db
*.db-shm
*.db-wal
.env
.env.*

# Python cache
__pycache__/
*.py[cod]

# OS files
Thumbs.db
.DS_Store
