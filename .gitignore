# Local builds and runtime state
/out/
/build/
/runtime/
/reports/
/.docker-temp/
/vcpkg_installed/

# Machine-specific model artifacts
/engines/*.engine
/engines/*.plan
/engines/*.onnx
/engines/*.pt
/engines/*.pth
/models/*
!/models/manifests/
!/models/manifests/*.json
/datasets/

# Training code is versioned; downloaded datasets, environments and generated
# checkpoints/evidence stay local.
/training/artifacts/
/training/datasets/
/training/downloads/
/training/tools/gdown-runtime/
/training/.venv/
/training/runs/

# Demo launch scripts/config are versioned, but source media, bundled tools and
# captured output are reproducible local assets.
/demo/**/sources/
/demo/**/tools/
/demo/**/output/

# Dataset payloads stay outside Git; only versioned manifests are tracked.
/data/raw/
/data/interim/
/data/processed/
/data/cache/

# IDE/user-specific files
/.vs/
/.vscode/
/CMakeUserPresets.json
/CMakeSettings.json
*.user
*.suo

# Logs, databases and secrets
*.log
*.db
*.db-shm
*.db-wal
.env
.env.*

# Python cache
__pycache__/
*.py[cod]

# OS files
Thumbs.db
.DS_Store
