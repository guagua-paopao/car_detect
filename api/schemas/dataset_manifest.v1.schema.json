{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://car-detect.local/schemas/dataset_manifest.v1.schema.json",
  "title": "VCAS Dataset Manifest v1",
  "description": "Versioned metadata contract for detection and vehicle-attribute datasets. Image payloads are stored outside Git.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_version",
    "labels_version",
    "created_at",
    "purpose",
    "license_review_status",
    "split_policy",
    "sources",
    "samples"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dataset_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
    },
    "labels_version": {
      "type": "string",
      "pattern": "^vehicle-labels-v[0-9]+$"
    },
    "created_at": {"type": "string", "format": "date-time"},
    "purpose": {
      "type": "string",
      "enum": ["detection", "attributes", "multitask"]
    },
    "license_review_status": {
      "type": "string",
      "enum": ["pending", "approved", "blocked"]
    },
    "split_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_keys", "ratios", "seed"],
      "properties": {
        "group_keys": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["camera_id", "video_id", "track_group"]
          }
        },
        "ratios": {
          "type": "object",
          "additionalProperties": false,
          "required": ["train", "validation", "test"],
          "properties": {
            "train": {"type": "number", "minimum": 0, "maximum": 1},
            "validation": {"type": "number", "minimum": 0, "maximum": 1},
            "test": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "seed": {"type": "integer", "minimum": 0},
        "closed_test_groups": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sample"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,199}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "name",
        "source_type",
        "license_id",
        "usage_status",
        "attribution_required",
        "redistribution_allowed"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "source_type": {
          "type": "string",
          "enum": ["public_dataset", "authorized_camera", "test_fixture"]
        },
        "license_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "license_url": {"type": "string", "format": "uri"},
        "authorization_ref": {"type": "string", "minLength": 1, "maxLength": 200},
        "usage_status": {
          "type": "string",
          "enum": [
            "approved_noncommercial",
            "approved_internal",
            "review_required",
            "blocked"
          ]
        },
        "attribution_required": {"type": "boolean"},
        "redistribution_allowed": {"type": "boolean"},
        "notes": {"type": "string", "maxLength": 1000}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "relative_path",
        "sha256",
        "source_id",
        "split",
        "task",
        "group",
        "image",
        "annotations"
      ],
      "properties": {
        "sample_id": {"$ref": "#/$defs/identifier"},
        "relative_path": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_id": {"$ref": "#/$defs/identifier"},
        "split": {
          "type": "string",
          "enum": ["train", "validation", "test"]
        },
        "task": {
          "type": "string",
          "enum": ["detection", "attributes", "multitask"]
        },
        "group": {
          "type": "object",
          "additionalProperties": false,
          "required": ["camera_id", "video_id", "track_group"],
          "properties": {
            "camera_id": {"$ref": "#/$defs/identifier"},
            "video_id": {"$ref": "#/$defs/identifier"},
            "track_group": {"$ref": "#/$defs/identifier"}
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": {"type": "integer", "minimum": 1, "maximum": 32768},
            "height": {"type": "integer", "minimum": 1, "maximum": 32768}
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "detection": {
              "type": "object",
              "additionalProperties": false,
              "required": ["bbox_xyxy_norm", "vehicle_class", "occluded", "truncated"],
              "properties": {
                "bbox_xyxy_norm": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {"type": "number", "minimum": 0, "maximum": 1}
                },
                "vehicle_class": {"type": "string"},
                "occluded": {"type": "boolean"},
                "truncated": {"type": "boolean"}
              }
            },
            "attributes": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "body_type",
                "color",
                "crop_quality",
                "viewpoint",
                "blur",
                "occluded",
                "truncated",
                "night"
              ],
              "properties": {
                "body_type": {"type": "string"},
                "color": {"type": "string"},
                "crop_quality": {"type": "string"},
                "viewpoint": {"type": "string"},
                "blur": {"type": "boolean"},
                "occluded": {"type": "boolean"},
                "truncated": {"type": "boolean"},
                "night": {"type": "boolean"}
              }
            }
          }
        }
      }
    }
  }
}
